DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/socialgenius
SECRET_KEY=replace-with-a-random-32-char-string
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── SocialGenius AI service (Video Studio AI Tools) ─────────────────────────────
# Default provider+model for AI Tools routed through app/services/ai/ (currently: AI Prompt
# Generator). Only the selected provider's own key below needs to be set.
AI_TEXT_PROVIDER=anthropic
AI_TEXT_MODEL=claude-sonnet-4-20250514
# OpenAI — only required if AI_TEXT_PROVIDER=openai (adapter is a structured placeholder for
# now; see app/services/ai/providers/openai_provider.py)
OPENAI_API_KEY=
# Google AI (Gemini) — only required if AI_TEXT_PROVIDER=google (adapter is a structured
# placeholder for now; see app/services/ai/providers/google_provider.py)
GOOGLE_AI_API_KEY=

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=500

# Beehiiv newsletter
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Google Business Profile
# Obtain an OAuth 2.0 access token via https://developers.google.com/identity/protocols/oauth2
GMB_ACCESS_TOKEN=
GMB_LOCATION_NAME=accounts/YOUR_ACCOUNT_ID/locations/YOUR_LOCATION_ID

# Canva Connect API — create an app at https://www.canva.com/developers/
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Apify — get token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Pixabay — get key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ── Phase 4: Production hardening ─────────────────────────────────────────────

# Sentry error tracking — create project at https://sentry.io
# Leave blank to disable Sentry
SENTRY_DSN=

# Redis — required for ARQ background queue (Railway: add a Redis plugin)
# Leave blank to fall back to in-process FastAPI BackgroundTasks
REDIS_URL=redis://localhost:6379

# ── Phase 5: Notifications, templates, assets ──────────────────────────────────

# Resend email API — get key at https://resend.com
# Leave blank to disable job completion emails
RESEND_API_KEY=

# From address used for notification emails (must be on a Resend-verified domain)
NOTIFY_FROM_EMAIL=SocialGenius <notifications@socialgenius.au>
